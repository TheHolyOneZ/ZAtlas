{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZAtlas",
  "version": "0.1.0",
  "identifier": "dev.theholyonez.zatlas",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZAtlas",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 720,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A map of a codebase you have never seen before",
    "longDescription": "ZAtlas points at a repository and draws the actual shape of it: module dependency graph, import cycles, a treemap of where the mass is, which files change together, which files change constantly, what is dead and what is a god-object. It reads git history for churn, ownership and co-change coupling, ranks explainable findings, and exports the map as D2 or Mermaid. Entirely local, entirely offline, and strictly read-only against your repository.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [],
        "desktopTemplate": "desktop-entry.desktop",
        "section": "devel",
        "priority": "optional",
        "files": {
          "/usr/share/metainfo/dev.theholyonez.zatlas.metainfo.xml": "dev.theholyonez.zatlas.metainfo.xml"
        }
      },
      "rpm": {
        "depends": [],
        "files": {
          "/usr/share/metainfo/dev.theholyonez.zatlas.metainfo.xml": "dev.theholyonez.zatlas.metainfo.xml"
        },
        "desktopTemplate": "desktop-entry.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "publisher": "TheHolyOneZ",
    "homepage": "https://zsync.eu/zatlas/",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright (c) 2026 TheHolyOneZ",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "ZAtlas"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "mainBinaryName": "zatlas-desktop"
}
